	sh:ignoredProperties _:c14n149 ;
	sh:property _:c14n66 , _:c14n94 ;
	sh:targetClass seeker:ReadingGuidance .
seeker:Reply a sh:NodeShape ;
	rdfs:comment "The advocate's answer to one critique." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n7 ;
	sh:property _:c14n118 , _:c14n123 , _:c14n132 ;
	sh:targetClass seeker:Reply .
seeker:Role a sh:NodeShape ;
	rdfs:comment "One agent role in the pipeline, defined by a versioned YAML file in prompts/: its model, persona, standing instructions and per-reading guidance." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n4 ;
	sh:property _:c14n12 , _:c14n177 , _:c14n186 , _:c14n2 , _:c14n27 , _:c14n35 , _:c14n45 , _:c14n48 ;
