seeker:AxisVerdict a sh:NodeShape ;
	rdfs:comment "The judge's verdict on one score axis of one comparison." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n172 ;
	sh:property _:c14n187 , _:c14n78 , _:c14n87 ;
	sh:targetClass seeker:AxisVerdict .
seeker:Card a sh:NodeShape ;
	rdfs:comment "One topic card, the atom of a draw. A draw takes one card from each of several decks and asks whether the collision is a real idea." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n1 ;
	sh:property _:c14n103 , _:c14n116 , _:c14n129 , _:c14n153 , _:c14n25 , _:c14n32 ;
	sh:targetClass seeker:Card .
seeker:CardReading a sh:NodeShape ;
	rdfs:comment "How the generator interpreted one drawn card. Under a metaphorical reading this is the only record of what a card was taken to mean." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n29 ;
	sh:property _:c14n17 , _:c14n21 ;
	sh:targetClass seeker:CardReading .
seeker:Citation a sh:NodeShape ;
	rdfs:comment "One piece of prior-art evidence: a web page the prosecutor's searches returned, or a work already in the vault's catalog." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n198 ;
	sh:property _:c14n110 , _:c14n154 , _:c14n161 , _:c14n162 , _:c14n96 ;
	sh:targetClass seeker:Citation .
seeker:Comparison a sh:NodeShape ;
	rdfs:comment "One blind pairwise judgment between two debated ideas, with a winner on each score axis." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n122 ;
	sh:property _:c14n139 , _:c14n170 , _:c14n178 , _:c14n26 , _:c14n30 , _:c14n91 ;
	sh:targetClass seeker:Comparison .
seeker:Critique a sh:NodeShape ;
	rdfs:comment "One critic's attack on one idea, naming the part that fails, how badly, and the failure in one sentence." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n9 ;
	sh:property _:c14n101 , _:c14n111 , _:c14n133 , _:c14n15 , _:c14n151 , _:c14n31 , _:c14n37 , _:c14n75 , _:c14n79 , _:c14n95 ;
	sh:targetClass seeker:Critique .
seeker:Debate a sh:NodeShape ;
	rdfs:comment "One idea's round of debate: the critiques it faced, the advocate's defense, and the statement that goes on to compete." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n36 ;
	sh:property _:c14n120 , _:c14n127 , _:c14n54 , _:c14n63 ;
	sh:targetClass seeker:Debate .
seeker:DebateFailure a sh:NodeShape ;
	rdfs:comment "A debate role that produced no valid answer for one idea, even after a retry." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n102 ;
	sh:property _:c14n135 , _:c14n173 , _:c14n18 , _:c14n199 , _:c14n22 , _:c14n84 ;
	sh:targetClass seeker:DebateFailure .
seeker:DebateRun a sh:NodeShape ;
	rdfs:comment "One debate over a recorded generation: its pinned inputs, every debate and failure, the tournament, and its usage and estimated cost." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n14 ;
	sh:property _:c14n0 , _:c14n100 , _:c14n126 , _:c14n137 , _:c14n171 , _:c14n188 , _:c14n190 , _:c14n194 , _:c14n201 , _:c14n34 , _:c14n41 , _:c14n67 , _:c14n69 , _:c14n90 ;
	sh:targetClass seeker:DebateRun .
seeker:Deck a sh:NodeShape ;
	rdfs:comment "All the cards on one axis of the morphological box, loaded from one file in decks/. Axes are independent, so cards from different decks combine freely." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n168 ;
	sh:property _:c14n119 , _:c14n121 , _:c14n128 , _:c14n77 ;
	sh:targetClass seeker:Deck .
seeker:DeckSet a sh:NodeShape ;
	rdfs:comment "Every deck a run draws from. Card ids are unique across the whole set and the set must include the required starting axes: technique, medium, historical-artifact, constraint and domain." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n11 ;
	sh:property _:c14n113 ;
	sh:targetClass seeker:DeckSet .
seeker:Defense a sh:NodeShape ;
	rdfs:comment "The advocate's answer to every critique of one idea, and what became of the idea." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n134 ;
	sh:property _:c14n196 , _:c14n33 , _:c14n51 , _:c14n76 , _:c14n81 ;
	sh:targetClass seeker:Defense .
seeker:Draw a sh:NodeShape ;
	rdfs:comment "One collision: three cards, one from each of three axes, always including a constraint. The raw material the generator turns into a one-sentence idea." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n125 ;
	sh:property _:c14n107 , _:c14n142 , _:c14n3 , _:c14n68 ;
	sh:targetClass seeker:Draw .
seeker:DrawBatch a sh:NodeShape ;
	rdfs:comment "A balanced set of draws produced from one seed and one deck set: shapes evenly represented, no card repeated, home fields rotating through the creative fields. Fully reproducible from its seed and deck-set digest." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n53 ;
	sh:property _:c14n131 , _:c14n148 , _:c14n60 ;
	sh:targetClass seeker:DrawBatch .
seeker:Generation a sh:NodeShape ;
	rdfs:comment "One generator pass over a draw batch: the ideas and failures it produced, every input pinned (batch, reading, model, role digest, commit), and its token usage and estimated cost." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n195 ;
	sh:property _:c14n109 , _:c14n165 , _:c14n179 , _:c14n183 , _:c14n184 , _:c14n50 , _:c14n56 , _:c14n57 , _:c14n64 , _:c14n74 , _:c14n83 ;
	sh:targetClass seeker:Generation .
seeker:GenerationFailure a sh:NodeShape ;
	rdfs:comment "A draw for which no valid idea was produced, even after a retry." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n105 ;
	sh:property _:c14n112 , _:c14n155 , _:c14n157 ;
	sh:targetClass seeker:GenerationFailure .
seeker:Idea a sh:NodeShape ;
	rdfs:comment "One idea generated from one draw: a single sentence of the form \"a/an X that does Y because Z\", its three parts, and how each card was read." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n191 ;
	sh:property _:c14n150 , _:c14n152 , _:c14n197 , _:c14n200 , _:c14n49 , _:c14n61 , _:c14n8 ;
	sh:targetClass seeker:Idea .
seeker:IdeaRevision a sh:NodeShape ;
