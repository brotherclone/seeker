seeker:Work a sh:NodeShape ;
	rdfs:comment "A creative work, instrument, game, publication or paper that already exists, captured as a note in the Obsidian vault and linked to the cards it embodies. Works are Seeker's offline prior art: a draw whose cards a work already combines is not new." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n164 ;
	sh:property _:c14n10 , _:c14n13 , _:c14n167 , _:c14n181 , _:c14n185 , _:c14n189 , _:c14n5 , _:c14n62 , _:c14n72 , _:c14n85 , _:c14n86 ;
