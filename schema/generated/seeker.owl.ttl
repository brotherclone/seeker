seeker:SearchTool\#filtered a owl:Class ;
	rdfs:label "filtered" ;
	rdfs:subClassOf seeker:SearchTool ;
	skos:definition "The model writes code that runs the searches and filters their results before it sees them (web_search_20260209). A search over the limit aborts the whole script, losing every result it had printed." .
seeker:SearchTool a owl:Class ;
	rdfs:label "SearchTool" ;
	owl:unionOf _:c14n502 ;
