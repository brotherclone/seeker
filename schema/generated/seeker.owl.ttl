@prefix seeker: <https://github.com/brotherclone/seeker/schema/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix pav: <http://purl.org/pav/> .
<https://github.com/brotherclone/seeker/schema.owl.ttl> dcterms:license "MIT" ;
	dcterms:title "Seeker ontology" ;
	pav:version "0.1.0" ;
	a owl:Ontology ;
	rdfs:label "seeker" ;
	rdfs:seeAlso <https://github.com/brotherclone/seeker/blob/develop/docs/concept.md> ;
	skos:definition "The ontology of record for Seeker, an idea engine for creative technology. Ideas are generated by colliding topic cards drawn from independent decks (a morphological box), checked against prior art, and argued over by adversarial agents. This schema defines the deck layer: cards, the decks that hold one axis of cards, the deck set a run draws from, and the creative fields cards belong to. Later changes extend it with ideas, roles, debates and runs." .
seeker:AxisId a rdfs:Datatype ;
	owl:equivalentClass _:c14n92 .
seeker:CaptureSource\#gabe a owl:Class ;
	rdfs:label "gabe" ;
	rdfs:subClassOf seeker:CaptureSource ;
	skos:definition "Captured by hand, usually with the Web Clipper template." .
seeker:CaptureSource\#import a owl:Class ;
	rdfs:label "import" ;
	rdfs:subClassOf seeker:CaptureSource ;
	skos:definition "Imported in bulk from another catalog." .
seeker:CaptureSource\#prosecutor a owl:Class ;
	rdfs:label "prosecutor" ;
	rdfs:subClassOf seeker:CaptureSource ;
	skos:definition "Found by the prior-art prosecutor during a debate and cached." .
seeker:CaptureSource a owl:Class ;
	rdfs:label "CaptureSource" ;
	owl:unionOf _:c14n13 ;
	skos:definition "Who or what added a work to the vault, so hand-captured works can be told apart from ones agents found or imported in bulk." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> ;
	linkml:permissible_values seeker:CaptureSource\#gabe , seeker:CaptureSource\#import , seeker:CaptureSource\#prosecutor .
seeker:Card a owl:Class ;
	rdfs:label "Card" ;
	rdfs:seeAlso <https://en.wikipedia.org/wiki/Morphological_analysis_(problem-solving)> ;
	rdfs:subClassOf _:c14n132 , _:c14n135 , _:c14n156 , _:c14n164 , _:c14n206 , _:c14n21 , _:c14n217 , _:c14n218 , _:c14n221 , _:c14n222 , _:c14n27 , _:c14n4 , _:c14n41 , _:c14n54 , _:c14n91 ;
	skos:definition "One topic card, the atom of a draw. A draw takes one card from each of several decks and asks whether the collision is a real idea." ;
	skos:exactMatch seeker:Card ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:CardId a rdfs:Datatype ;
	owl:equivalentClass _:c14n126 .
seeker:CardReading a owl:Class ;
	rdfs:label "CardReading" ;
	rdfs:subClassOf _:c14n116 , _:c14n176 , _:c14n214 , _:c14n224 , _:c14n231 , _:c14n94 ;
	skos:definition "How the generator interpreted one drawn card. Under a metaphorical reading this is the only record of what a card was taken to mean." ;
	skos:exactMatch seeker:CardReading ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:CreativeField\#comics a owl:Class ;
	rdfs:label "comics" ;
	rdfs:subClassOf seeker:CreativeField ;
	skos:definition "Comics, sequential art, strips, webcomics and minicomics." .
seeker:CreativeField\#electronics a owl:Class ;
	rdfs:label "electronics" ;
	rdfs:subClassOf seeker:CreativeField ;
	skos:definition "Sensors, circuits, microcontrollers, displays and physical computing." .
seeker:CreativeField\#film a owl:Class ;
	rdfs:label "film" ;
	rdfs:subClassOf seeker:CreativeField ;
	skos:definition "Film, video, animation and moving-image work of any length or format." .
seeker:CreativeField\#games a owl:Class ;
	rdfs:label "games" ;
	rdfs:subClassOf seeker:CreativeField ;
	skos:definition "Board, card, tabletop role-playing and electronic games." .
seeker:CreativeField\#music a owl:Class ;
	rdfs:label "music" ;
	rdfs:subClassOf seeker:CreativeField ;
	skos:definition "Composition, performance, sound design, synthesis and audio production." .
seeker:CreativeField\#visual-art a owl:Class ;
	rdfs:label "visual-art" ;
	rdfs:subClassOf seeker:CreativeField ;
	skos:definition "Drawing, painting, printmaking, generative and computational visual art, installation." .
seeker:CreativeField\#writing a owl:Class ;
	rdfs:label "writing" ;
	rdfs:subClassOf seeker:CreativeField ;
	skos:definition "Creative writing, poetry, interactive and procedural text, audio drama." .
seeker:CreativeField a owl:Class ;
	rdfs:label "CreativeField" ;
	owl:unionOf _:c14n229 ;
	skos:definition "The creative fields Seeker draws ideas from. A card belongs to every field it lists; a card listing none is cross-cutting and applies to all fields. Cards spanning several fields are the bridges between literatures that literature-based discovery looks for." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> ;
	linkml:permissible_values seeker:CreativeField\#comics , seeker:CreativeField\#electronics , seeker:CreativeField\#film , seeker:CreativeField\#games , seeker:CreativeField\#music , seeker:CreativeField\#visual-art , seeker:CreativeField\#writing .
seeker:Deck a owl:Class ;
	rdfs:label "Deck" ;
	rdfs:subClassOf _:c14n0 , _:c14n127 , _:c14n129 , _:c14n131 , _:c14n137 , _:c14n142 , _:c14n152 , _:c14n194 , _:c14n196 , _:c14n199 , _:c14n90 ;
	skos:definition "All the cards on one axis of the morphological box, loaded from one file in decks/. Axes are independent, so cards from different decks combine freely." ;
	skos:exactMatch seeker:Deck ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:DeckSet a owl:Class ;
	rdfs:label "DeckSet" ;
	rdfs:subClassOf _:c14n29 , _:c14n87 ;
	skos:definition "Every deck a run draws from. Card ids are unique across the whole set and the set must include the required starting axes: technique, medium, historical-artifact, constraint and domain." ;
	skos:exactMatch seeker:DeckSet ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:Draw a owl:Class ;
	rdfs:label "Draw" ;
	rdfs:subClassOf _:c14n109 , _:c14n136 , _:c14n169 , _:c14n182 , _:c14n190 , _:c14n202 , _:c14n207 , _:c14n220 , _:c14n233 , _:c14n64 , _:c14n70 , _:c14n86 ;
	skos:definition "One collision: three cards, one from each of three axes, always including a constraint. The raw material the generator turns into a one-sentence idea." ;
	skos:exactMatch seeker:Draw ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:DrawBatch a owl:Class ;
	rdfs:label "DrawBatch" ;
	rdfs:subClassOf _:c14n141 , _:c14n159 , _:c14n227 , _:c14n31 , _:c14n43 , _:c14n73 , _:c14n75 , _:c14n9 ;
	skos:definition "A balanced set of draws produced from one seed and one deck set: shapes evenly represented, no card repeated, home fields rotating through the creative fields. Fully reproducible from its seed and deck-set digest." ;
	skos:exactMatch seeker:DrawBatch ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:Effort\#high a owl:Class ;
	rdfs:label "high" ;
	rdfs:subClassOf seeker:Effort ;
	skos:definition "Thorough; the default for creative roles." .
seeker:Effort\#low a owl:Class ;
	rdfs:label "low" ;
	rdfs:subClassOf seeker:Effort ;
	skos:definition "Quickest and cheapest; minimal deliberation." .
seeker:Effort\#max a owl:Class ;
	rdfs:label "max" ;
	rdfs:subClassOf seeker:Effort ;
	skos:definition "The most thorough the model offers; slowest and costliest." .
seeker:Effort\#medium a owl:Class ;
	rdfs:label "medium" ;
	rdfs:subClassOf seeker:Effort ;
	skos:definition "Balanced speed and thoroughness." .
seeker:Effort\#xhigh a owl:Class ;
	rdfs:label "xhigh" ;
	rdfs:subClassOf seeker:Effort ;
	skos:definition "More thorough than high, at higher cost." .
seeker:Effort a owl:Class ;
	rdfs:label "Effort" ;
	owl:unionOf _:c14n200 ;
	skos:definition "How much effort a model puts into a response, as the Claude API's output_config.effort. Higher effort is more thorough, slower and costlier." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> ;
	linkml:permissible_values seeker:Effort\#high , seeker:Effort\#low , seeker:Effort\#max , seeker:Effort\#medium , seeker:Effort\#xhigh .
seeker:Generation a owl:Class ;
	rdfs:label "Generation" ;
	rdfs:subClassOf _:c14n104 , _:c14n112 , _:c14n114 , _:c14n115 , _:c14n117 , _:c14n12 , _:c14n133 , _:c14n138 , _:c14n158 , _:c14n166 , _:c14n172 , _:c14n175 , _:c14n18 , _:c14n184 , _:c14n186 , _:c14n188 , _:c14n192 , _:c14n211 , _:c14n212 , _:c14n225 , _:c14n57 , _:c14n58 , _:c14n6 , _:c14n62 , _:c14n66 , _:c14n68 , _:c14n69 , _:c14n7 , _:c14n74 , _:c14n8 , _:c14n80 ;
	skos:definition "One generator pass over a draw batch: the ideas and failures it produced, every input pinned (batch, reading, model, role digest, commit), and its token usage and estimated cost." ;
	skos:exactMatch seeker:Generation ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:GenerationFailure a owl:Class ;
	rdfs:label "GenerationFailure" ;
	rdfs:subClassOf _:c14n147 , _:c14n17 , _:c14n189 , _:c14n204 , _:c14n226 , _:c14n235 , _:c14n40 , _:c14n71 , _:c14n81 ;
	skos:definition "A draw for which no valid idea was produced, even after a retry." ;
	skos:exactMatch seeker:GenerationFailure ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:GitCommit a rdfs:Datatype ;
	owl:equivalentClass _:c14n143 .
seeker:Idea a owl:Class ;
	rdfs:label "Idea" ;
	rdfs:subClassOf _:c14n10 , _:c14n101 , _:c14n123 , _:c14n144 , _:c14n146 , _:c14n148 , _:c14n167 , _:c14n179 , _:c14n185 , _:c14n193 , _:c14n201 , _:c14n213 , _:c14n216 , _:c14n24 , _:c14n28 , _:c14n34 , _:c14n35 , _:c14n5 , _:c14n82 , _:c14n83 , _:c14n97 ;
	skos:definition "One idea generated from one draw: a single sentence of the form \"a/an X that does Y because Z\", its three parts, and how each card was read." ;
	skos:exactMatch seeker:Idea ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:ModelId a rdfs:Datatype ;
	owl:equivalentClass _:c14n60 .
seeker:Reading\#literal a owl:Class ;
	rdfs:label "literal" ;
	rdfs:subClassOf seeker:Reading ;
	skos:definition "Cards mean exactly what they name." .
seeker:Reading\#loose a owl:Class ;
	rdfs:label "loose" ;
	rdfs:subClassOf seeker:Reading ;
	skos:definition "Cards may be taken by their spirit as well as their letter." .
seeker:Reading\#metaphorical a owl:Class ;
	rdfs:label "metaphorical" ;
	rdfs:subClassOf seeker:Reading ;
	skos:definition "Cards may stand for something they evoke rather than what they name." .
seeker:Reading a owl:Class ;
	rdfs:label "Reading" ;
	owl:unionOf _:c14n65 ;
	skos:definition "How freely the generator may interpret the cards it is dealt. Round 1 reads literally; round 2 varies only this setting." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> ;
	linkml:permissible_values seeker:Reading\#literal , seeker:Reading\#loose , seeker:Reading\#metaphorical .
seeker:ReadingGuidance a owl:Class ;
	rdfs:label "ReadingGuidance" ;
	rdfs:subClassOf _:c14n121 , _:c14n128 , _:c14n134 , _:c14n15 , _:c14n234 , _:c14n63 ;
	skos:definition "The prompt text a role uses for one Reading setting." ;
	skos:exactMatch seeker:ReadingGuidance ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:Role a owl:Class ;
	rdfs:label "Role" ;
	rdfs:subClassOf _:c14n107 , _:c14n118 , _:c14n130 , _:c14n140 , _:c14n150 , _:c14n151 , _:c14n157 , _:c14n177 , _:c14n181 , _:c14n191 , _:c14n197 , _:c14n228 , _:c14n26 , _:c14n30 , _:c14n32 , _:c14n36 , _:c14n39 , _:c14n42 , _:c14n44 , _:c14n84 , _:c14n85 ;
	skos:definition "One agent role in the pipeline, defined by a versioned YAML file in prompts/: its model, persona, standing instructions and per-reading guidance." ;
	skos:exactMatch seeker:Role ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:RoleName\#generator a owl:Class ;
	rdfs:label "generator" ;
	rdfs:subClassOf seeker:RoleName ;
	skos:definition "Turns one draw into one idea stated as a single sentence." .
seeker:RoleName a owl:Class ;
	rdfs:label "RoleName" ;
	skos:definition "The agent roles in Seeker's pipeline. Each role is defined by a YAML file in prompts/. Only the generator exists so far; the debate adds the rest." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> ;
	linkml:permissible_values seeker:RoleName\#generator .
seeker:Sha256Digest a rdfs:Datatype ;
	owl:equivalentClass _:c14n46 .
seeker:Synonym a rdfs:Datatype ;
	owl:equivalentClass _:c14n47 .
seeker:Tag a rdfs:Datatype ;
	owl:equivalentClass _:c14n59 .
seeker:Url a rdfs:Datatype ;
	owl:equivalentClass _:c14n215 .
seeker:Usage a owl:Class ;
	rdfs:label "Usage" ;
	rdfs:subClassOf _:c14n120 , _:c14n122 , _:c14n165 , _:c14n180 , _:c14n195 , _:c14n198 , _:c14n219 , _:c14n232 , _:c14n61 , _:c14n72 , _:c14n77 , _:c14n89 ;
	skos:definition "Token counts for one or more model calls, split the way they are billed." ;
	skos:exactMatch seeker:Usage ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:Work a owl:Class ;
	rdfs:label "Work" ;
	rdfs:seeAlso <https://en.wikipedia.org/wiki/Literature-based_discovery> ;
	rdfs:subClassOf _:c14n1 , _:c14n100 , _:c14n105 , _:c14n106 , _:c14n108 , _:c14n110 , _:c14n124 , _:c14n14 , _:c14n149 , _:c14n153 , _:c14n168 , _:c14n173 , _:c14n174 , _:c14n178 , _:c14n187 , _:c14n2 , _:c14n209 , _:c14n210 , _:c14n22 , _:c14n25 , _:c14n33 , _:c14n37 , _:c14n38 , _:c14n45 , _:c14n48 , _:c14n49 , _:c14n51 , _:c14n78 , _:c14n88 , _:c14n93 ;
	skos:definition "A creative work, instrument, game, publication or paper that already exists, captured as a note in the Obsidian vault and linked to the cards it embodies. Works are Seeker's offline prior art: a draw whose cards a work already combines is not new." ;
	skos:exactMatch seeker:Work ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:WorkId a rdfs:Datatype ;
	owl:equivalentClass _:c14n96 .
seeker:WorkKind\#game a owl:Class ;
	rdfs:label "game" ;
	rdfs:subClassOf seeker:WorkKind ;
	skos:definition "A board, card, tabletop or electronic game." .
seeker:WorkKind\#installation a owl:Class ;
	rdfs:label "installation" ;
	rdfs:subClassOf seeker:WorkKind ;
	skos:definition "A site-specific or gallery installation." .
seeker:WorkKind\#instrument a owl:Class ;
	rdfs:label "instrument" ;
	rdfs:subClassOf seeker:WorkKind ;
	skos:definition "A musical instrument or sound-making machine, built or designed." .
seeker:WorkKind\#other a owl:Class ;
	rdfs:label "other" ;
	rdfs:subClassOf seeker:WorkKind ;
	skos:definition "Anything else; the capture default until refined by hand." .
seeker:WorkKind\#paper a owl:Class ;
	rdfs:label "paper" ;
	rdfs:subClassOf seeker:WorkKind ;
	skos:definition "A research paper, thesis or technical report." .
seeker:WorkKind\#performance a owl:Class ;
	rdfs:label "performance" ;
	rdfs:subClassOf seeker:WorkKind ;
	skos:definition "A live performance, concert or happening." .
seeker:WorkKind\#piece a owl:Class ;
	rdfs:label "piece" ;
	rdfs:subClassOf seeker:WorkKind ;
	skos:definition "A finished artwork, composition or comic not better described by another kind." .
seeker:WorkKind\#product a owl:Class ;
	rdfs:label "product" ;
	rdfs:subClassOf seeker:WorkKind ;
	skos:definition "A commercial device or kit." .
seeker:WorkKind\#publication a owl:Class ;
	rdfs:label "publication" ;
	rdfs:subClassOf seeker:WorkKind ;
	skos:definition "A book, zine, magazine, album booklet or other edition." .
seeker:WorkKind\#recording a owl:Class ;
	rdfs:label "recording" ;
	rdfs:subClassOf seeker:WorkKind ;
	skos:definition "A released or archived audio or video recording." .
seeker:WorkKind\#software a owl:Class ;
	rdfs:label "software" ;
	rdfs:subClassOf seeker:WorkKind ;
	skos:definition "A program, plugin, tool or code library." .
seeker:WorkKind a owl:Class ;
	rdfs:label "WorkKind" ;
	owl:unionOf _:c14n160 ;
	skos:definition "What sort of thing a captured work is. Coarse on purpose: the cards a work links say what it is about, the kind says what form it takes." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> ;
	linkml:permissible_values seeker:WorkKind\#game , seeker:WorkKind\#installation , seeker:WorkKind\#instrument , seeker:WorkKind\#other , seeker:WorkKind\#paper , seeker:WorkKind\#performance , seeker:WorkKind\#piece , seeker:WorkKind\#product , seeker:WorkKind\#publication , seeker:WorkKind\#recording , seeker:WorkKind\#software .
seeker:axes a owl:DatatypeProperty ;
	rdfs:label "axes" ;
	rdfs:range seeker:AxisId ;
	skos:definition "The three axes the draw's cards come from, constraint first, then the other two in canonical order (technique, medium, historical-artifact, domain). This is the draw's shape." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:axis a owl:DatatypeProperty ;
	rdfs:label "axis" ;
	rdfs:range seeker:AxisId ;
	skos:definition "The axis this deck holds; must match the deck file's name." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:behavior a owl:DatatypeProperty ;
	rdfs:label "behavior" ;
	rdfs:range xsd:string ;
	skos:definition "The Y of the statement, meaning what the thing does." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:cache_read_tokens a owl:DatatypeProperty ;
	rdfs:label "cache_read_tokens" ;
	rdfs:range _:c14n162 ;
	skos:definition "Input tokens served from the prompt cache." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:cache_write_tokens a owl:DatatypeProperty ;
	rdfs:label "cache_write_tokens" ;
	rdfs:range _:c14n67 ;
	skos:definition "Input tokens written to the prompt cache." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:captured_by a owl:ObjectProperty ;
	rdfs:label "captured_by" ;
	rdfs:range seeker:CaptureSource ;
	skos:definition "Who or what added the work to the vault." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:captured_on a owl:DatatypeProperty ;
	rdfs:label "captured_on" ;
	rdfs:range xsd:date ;
	skos:definition "The date the work was added to the vault." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:card a owl:ObjectProperty ;
	rdfs:label "card" ;
	rdfs:range seeker:Card ;
	skos:definition "The card being interpreted, referenced by card id." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:card_readings a owl:ObjectProperty ;
	rdfs:label "card_readings" ;
	rdfs:range seeker:CardReading ;
	skos:definition "How the generator read each drawn card, in the draw's card order." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:cards a owl:ObjectProperty ;
	rdfs:label "cards" ;
	rdfs:range seeker:Card ;
	skos:definition "The cards on this axis, in a meaningful order." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:creators a owl:DatatypeProperty ;
	rdfs:label "creators" ;
	rdfs:range xsd:string ;
	skos:definition "The people or groups who made the work, as plain names. Notes may write them as wikilinks so they show up in the vault's graph." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:deck_set_digest a owl:DatatypeProperty ;
	rdfs:label "deck_set_digest" ;
	rdfs:range seeker:Sha256Digest ;
	skos:definition "Digest of the deck set the batch was drawn from. Replaying against decks with a different digest is an error." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:decks a owl:ObjectProperty ;
	rdfs:label "decks" ;
	rdfs:range seeker:Deck ;
	skos:definition "Every deck in the set, one per axis." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:description a owl:DatatypeProperty ;
	rdfs:label "description" ;
	rdfs:range xsd:string ;
	skos:definition "One line on what the axis contributes to a draw." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:draw_batch a owl:ObjectProperty ;
	rdfs:label "draw_batch" ;
	rdfs:range seeker:DrawBatch ;
	skos:definition "The batch the ideas were generated from, embedded so the record stands alone." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:drawn_cards a owl:ObjectProperty ;
	rdfs:label "drawn_cards" ;
	rdfs:range seeker:Card ;
	skos:definition "The drawn cards, referenced by card id, one per axis in the same order as axes." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:draws a owl:ObjectProperty ;
	rdfs:label "draws" ;
	rdfs:range seeker:Draw ;
	skos:definition "The draws in the batch, in position order." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:effort a owl:ObjectProperty ;
	rdfs:label "effort" ;
	rdfs:range seeker:Effort ;
	skos:definition "How much effort the model puts into each call of this role. This is the API's output_config.effort, which replaced sampling temperature." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:estimated_cost_usd a owl:DatatypeProperty ;
	rdfs:label "estimated_cost_usd" ;
	rdfs:range _:c14n103 ;
	skos:definition "The total usage priced with the configured price table. It is an estimate, because prices change and are kept as data." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:failures a owl:ObjectProperty ;
	rdfs:label "failures" ;
	rdfs:range seeker:GenerationFailure ;
	skos:definition "Draws that produced no valid idea, in position order." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:fields a owl:ObjectProperty ;
	rdfs:label "fields" ;
	rdfs:range seeker:CreativeField ;
	skos:definition "The creative fields the card belongs to. Empty means cross-cutting: the card applies to every field." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:generated_at a owl:DatatypeProperty ;
	rdfs:label "generated_at" ;
	rdfs:range xsd:dateTime ;
	skos:definition "When the generation started." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:git_commit a owl:DatatypeProperty ;
	rdfs:label "git_commit" ;
	rdfs:range seeker:GitCommit ;
	skos:definition "The repository commit the generation ran from, when known." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:guidance a owl:DatatypeProperty ;
	rdfs:label "guidance" ;
	rdfs:range xsd:string ;
	skos:definition "The prompt text that tells the model how to read the cards at this setting." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:home_field a owl:ObjectProperty ;
	rdfs:label "home_field" ;
	rdfs:range seeker:CreativeField ;
	skos:definition "The creative field this draw is anchored in. At least one of its cards explicitly lists this field." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:id a owl:DatatypeProperty ;
	rdfs:label "id" ;
	rdfs:range seeker:CardId ;
	skos:definition "The card's stable identifier, unique across the deck set." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:ideas a owl:ObjectProperty ;
	rdfs:label "ideas" ;
	rdfs:range seeker:Idea ;
	skos:definition "The ideas produced, in draw position order." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:input_tokens a owl:DatatypeProperty ;
	rdfs:label "input_tokens" ;
	rdfs:range _:c14n111 ;
	skos:definition "Uncached input tokens billed at the model's input rate." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:interpretation a owl:DatatypeProperty ;
	rdfs:label "interpretation" ;
	rdfs:range xsd:string ;
	skos:definition "One line on how the card was taken in this idea." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:kind a owl:ObjectProperty ;
	rdfs:label "kind" ;
	rdfs:range seeker:WorkKind ;
	skos:definition "What form the work takes." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:max_output_tokens a owl:DatatypeProperty ;
	rdfs:label "max_output_tokens" ;
	rdfs:range _:c14n203 ;
	skos:definition "The most output tokens one call of this role may produce." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:model a owl:DatatypeProperty ;
	rdfs:label "model" ;
	rdfs:range seeker:ModelId ;
	skos:definition "The Claude model the role runs on." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:name a owl:DatatypeProperty ;
	rdfs:label "name" ;
	rdfs:range xsd:string ;
	skos:definition "Human-readable name, as it should appear in prompts and reports." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:note a owl:DatatypeProperty ;
	rdfs:label "note" ;
	rdfs:range xsd:string ;
	skos:definition "Optional clarification of what the card means or excludes." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:output_tokens a owl:DatatypeProperty ;
	rdfs:label "output_tokens" ;
	rdfs:range _:c14n99 ;
	skos:definition "Output tokens billed at the model's output rate." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:persona a owl:DatatypeProperty ;
	rdfs:label "persona" ;
	rdfs:range xsd:string ;
	skos:definition "Who the role speaks as, which sets its taste and its blind spots." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:position a owl:DatatypeProperty ;
	rdfs:label "position" ;
	rdfs:range _:c14n170 ;
	skos:definition "The draw's 1-based position within its batch." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:rationale a owl:DatatypeProperty ;
	rdfs:label "rationale" ;
	rdfs:range xsd:string ;
	skos:definition "The Z of the statement, meaning why the idea works or matters, as a real reason rather than a restatement." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:reading a owl:ObjectProperty ;
	rdfs:label "reading" ;
	rdfs:range seeker:Reading ;
	skos:definition "How freely the cards may be interpreted." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:reading_guidance a owl:ObjectProperty ;
	rdfs:label "reading_guidance" ;
	rdfs:range seeker:ReadingGuidance ;
	skos:definition "Exactly one guidance text per Reading value." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:reason a owl:DatatypeProperty ;
	rdfs:label "reason" ;
	rdfs:range xsd:string ;
	skos:definition "Why no idea was recorded for this draw." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:role_digest a owl:DatatypeProperty ;
	rdfs:label "role_digest" ;
	rdfs:range seeker:Sha256Digest ;
	skos:definition "SHA-256 of the role file's bytes, so any prompt edit is visible." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:role_name a owl:ObjectProperty ;
	rdfs:label "role_name" ;
	rdfs:range seeker:RoleName ;
	skos:definition "Which role in the pipeline this is." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:seed a owl:DatatypeProperty ;
	rdfs:label "seed" ;
	rdfs:range _:c14n56 ;
	skos:definition "The non-negative integer the draw's random stream is derived from. The same seed, deck content and batch size always produce the same batch." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:statement a owl:DatatypeProperty ;
	rdfs:label "statement" ;
	rdfs:range xsd:string ;
	skos:definition "The idea as one sentence of the form \"a/an X that does Y because Z\", at most 60 words." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:subject a owl:DatatypeProperty ;
	rdfs:label "subject" ;
	rdfs:range xsd:string ;
	skos:definition "The X of the statement, meaning the thing being made." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:summary a owl:DatatypeProperty ;
	rdfs:label "summary" ;
	rdfs:range xsd:string ;
	skos:definition "A short description of the work. Card suggestions search it along with the title and the note body." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:synonyms a owl:DatatypeProperty ;
	rdfs:label "synonyms" ;
	rdfs:range seeker:Synonym ;
	skos:definition "Other names for the card in specialist literatures, used to expand prior-art searches. Must not repeat the name or each other, case-insensitively." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:system_prompt a owl:DatatypeProperty ;
	rdfs:label "system_prompt" ;
	rdfs:range xsd:string ;
	skos:definition "The role's standing instructions and rules." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:tags a owl:DatatypeProperty ;
	rdfs:label "tags" ;
	rdfs:range seeker:Tag ;
	skos:definition "Free-form labels outside the creative-field vocabulary." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:title a owl:DatatypeProperty ;
	rdfs:label "title" ;
	rdfs:range xsd:string ;
	skos:definition "The work's title as its creators give it." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:url a owl:DatatypeProperty ;
	rdfs:label "url" ;
	rdfs:range seeker:Url ;
	skos:definition "Where the work can be found or was captured from." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:usage a owl:ObjectProperty ;
	rdfs:label "usage" ;
	rdfs:range seeker:Usage ;
	skos:definition "Tokens consumed by the model calls this record accounts for." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:year a owl:DatatypeProperty ;
	rdfs:label "year" ;
	rdfs:range xsd:integer ;
	skos:definition "The year the work was made, released or published, when known." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
