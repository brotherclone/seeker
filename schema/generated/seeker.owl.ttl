@prefix seeker: <https://github.com/brotherclone/seeker/schema/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix pav: <http://purl.org/pav/> .
<https://github.com/brotherclone/seeker/schema.owl.ttl> dcterms:license "MIT" ;
	dcterms:title "Seeker ontology" ;
	pav:version "0.1.0" ;
	a owl:Ontology ;
	rdfs:label "seeker" ;
	rdfs:seeAlso <https://github.com/brotherclone/seeker/blob/develop/docs/concept.md> ;
	skos:definition "The ontology of record for Seeker, an idea engine for creative technology. Ideas are generated by colliding topic cards drawn from independent decks (a morphological box), checked against prior art, and argued over by adversarial agents. This schema defines the deck layer: cards, the decks that hold one axis of cards, the deck set a run draws from, and the creative fields cards belong to. Later changes extend it with ideas, roles, debates and runs." .
seeker:AxisId a rdfs:Datatype ;
	owl:equivalentClass _:c14n25 .
seeker:Card a owl:Class ;
	rdfs:label "Card" ;
	rdfs:seeAlso <https://en.wikipedia.org/wiki/Morphological_analysis_(problem-solving)> ;
	rdfs:subClassOf _:c14n1 , _:c14n14 , _:c14n24 , _:c14n33 , _:c14n34 , _:c14n4 , _:c14n41 , _:c14n44 , _:c14n5 , _:c14n53 , _:c14n56 , _:c14n57 , _:c14n59 , _:c14n60 , _:c14n8 ;
	skos:definition "One topic card, the atom of a draw. A draw takes one card from each of several decks and asks whether the collision is a real idea." ;
	skos:exactMatch seeker:Card ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:CardId a rdfs:Datatype ;
	owl:equivalentClass _:c14n29 .
seeker:CreativeField\#comics a owl:Class ;
	rdfs:label "comics" ;
	rdfs:subClassOf seeker:CreativeField ;
	skos:definition "Comics, sequential art, strips, webcomics and minicomics." .
seeker:CreativeField\#electronics a owl:Class ;
	rdfs:label "electronics" ;
	rdfs:subClassOf seeker:CreativeField ;
	skos:definition "Sensors, circuits, microcontrollers, displays and physical computing." .
seeker:CreativeField\#film a owl:Class ;
	rdfs:label "film" ;
	rdfs:subClassOf seeker:CreativeField ;
	skos:definition "Film, video, animation and moving-image work of any length or format." .
seeker:CreativeField\#games a owl:Class ;
	rdfs:label "games" ;
	rdfs:subClassOf seeker:CreativeField ;
	skos:definition "Board, card, tabletop role-playing and electronic games." .
seeker:CreativeField\#music a owl:Class ;
	rdfs:label "music" ;
	rdfs:subClassOf seeker:CreativeField ;
	skos:definition "Composition, performance, sound design, synthesis and audio production." .
seeker:CreativeField\#visual-art a owl:Class ;
	rdfs:label "visual-art" ;
	rdfs:subClassOf seeker:CreativeField ;
	skos:definition "Drawing, painting, printmaking, generative and computational visual art, installation." .
seeker:CreativeField\#writing a owl:Class ;
	rdfs:label "writing" ;
	rdfs:subClassOf seeker:CreativeField ;
	skos:definition "Creative writing, poetry, interactive and procedural text, audio drama." .
seeker:CreativeField a owl:Class ;
	rdfs:label "CreativeField" ;
	owl:unionOf _:c14n62 ;
	skos:definition "The creative fields Seeker draws ideas from. A card belongs to every field it lists; a card listing none is cross-cutting and applies to all fields. Cards spanning several fields are the bridges between literatures that literature-based discovery looks for." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> ;
	linkml:permissible_values seeker:CreativeField\#comics , seeker:CreativeField\#electronics , seeker:CreativeField\#film , seeker:CreativeField\#games , seeker:CreativeField\#music , seeker:CreativeField\#visual-art , seeker:CreativeField\#writing .
seeker:Deck a owl:Class ;
	rdfs:label "Deck" ;
	rdfs:subClassOf _:c14n0 , _:c14n23 , _:c14n30 , _:c14n31 , _:c14n32 , _:c14n36 , _:c14n38 , _:c14n40 , _:c14n49 , _:c14n50 , _:c14n51 ;
	skos:definition "All the cards on one axis of the morphological box, loaded from one file in decks/. Axes are independent, so cards from different decks combine freely." ;
	skos:exactMatch seeker:Deck ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:DeckSet a owl:Class ;
	rdfs:label "DeckSet" ;
	rdfs:subClassOf _:c14n22 , _:c14n6 ;
	skos:definition "Every deck a run draws from. Card ids are unique across the whole set and the set must include the required starting axes: technique, medium, historical-artifact, constraint and domain." ;
	skos:exactMatch seeker:DeckSet ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:Draw a owl:Class ;
	rdfs:label "Draw" ;
	rdfs:subClassOf _:c14n17 , _:c14n18 , _:c14n21 , _:c14n27 , _:c14n35 , _:c14n45 , _:c14n47 , _:c14n48 , _:c14n52 , _:c14n54 , _:c14n58 , _:c14n63 ;
	skos:definition "One collision: three cards, one from each of three axes, always including a constraint. The raw material the generator turns into a one-sentence idea." ;
	skos:exactMatch seeker:Draw ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:DrawBatch a owl:Class ;
	rdfs:label "DrawBatch" ;
	rdfs:subClassOf _:c14n19 , _:c14n2 , _:c14n20 , _:c14n37 , _:c14n42 , _:c14n61 , _:c14n7 , _:c14n9 ;
	skos:definition "A balanced set of draws produced from one seed and one deck set: shapes evenly represented, no card repeated, home fields rotating through the creative fields. Fully reproducible from its seed and deck-set digest." ;
	skos:exactMatch seeker:DrawBatch ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:Sha256Digest a rdfs:Datatype ;
	owl:equivalentClass _:c14n10 .
seeker:Synonym a rdfs:Datatype ;
	owl:equivalentClass _:c14n11 .
seeker:Tag a rdfs:Datatype ;
	owl:equivalentClass _:c14n16 .
seeker:axes a owl:DatatypeProperty ;
	rdfs:label "axes" ;
	rdfs:range seeker:AxisId ;
	skos:definition "The three axes the draw's cards come from, constraint first, then the other two in canonical order (technique, medium, historical-artifact, domain). This is the draw's shape." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:axis a owl:DatatypeProperty ;
	rdfs:label "axis" ;
	rdfs:range seeker:AxisId ;
	skos:definition "The axis this deck holds; must match the deck file's name." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:cards a owl:ObjectProperty ;
	rdfs:label "cards" ;
	rdfs:range seeker:Card ;
	skos:definition "The cards on this axis, in a meaningful order." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:deck_set_digest a owl:DatatypeProperty ;
	rdfs:label "deck_set_digest" ;
	rdfs:range seeker:Sha256Digest ;
	skos:definition "Digest of the deck set the batch was drawn from. Replaying against decks with a different digest is an error." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:decks a owl:ObjectProperty ;
	rdfs:label "decks" ;
	rdfs:range seeker:Deck ;
	skos:definition "Every deck in the set, one per axis." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:description a owl:DatatypeProperty ;
	rdfs:label "description" ;
	rdfs:range xsd:string ;
	skos:definition "One line on what the axis contributes to a draw." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:drawn_cards a owl:ObjectProperty ;
	rdfs:label "drawn_cards" ;
	rdfs:range seeker:Card ;
	skos:definition "The drawn cards, referenced by card id, one per axis in the same order as axes." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:draws a owl:ObjectProperty ;
	rdfs:label "draws" ;
	rdfs:range seeker:Draw ;
	skos:definition "The draws in the batch, in position order." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:fields a owl:ObjectProperty ;
	rdfs:label "fields" ;
	rdfs:range seeker:CreativeField ;
	skos:definition "The creative fields the card belongs to. Empty means cross-cutting: the card applies to every field." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:home_field a owl:ObjectProperty ;
	rdfs:label "home_field" ;
	rdfs:range seeker:CreativeField ;
	skos:definition "The creative field this draw is anchored in. At least one of its cards explicitly lists this field." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:id a owl:DatatypeProperty ;
	rdfs:label "id" ;
	rdfs:range seeker:CardId ;
	skos:definition "The card's stable identifier, unique across the deck set." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:name a owl:DatatypeProperty ;
	rdfs:label "name" ;
	rdfs:range xsd:string ;
	skos:definition "Human-readable name, as it should appear in prompts and reports." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:note a owl:DatatypeProperty ;
	rdfs:label "note" ;
	rdfs:range xsd:string ;
	skos:definition "Optional clarification of what the card means or excludes." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:position a owl:DatatypeProperty ;
	rdfs:label "position" ;
	rdfs:range _:c14n46 ;
	skos:definition "The draw's 1-based position within its batch." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:seed a owl:DatatypeProperty ;
	rdfs:label "seed" ;
	rdfs:range _:c14n15 ;
	skos:definition "The non-negative integer the draw's random stream is derived from. The same seed, deck content and batch size always produce the same batch." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:synonyms a owl:DatatypeProperty ;
	rdfs:label "synonyms" ;
	rdfs:range seeker:Synonym ;
	skos:definition "Other names for the card in specialist literatures, used to expand prior-art searches. Must not repeat the name or each other, case-insensitively." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:tags a owl:DatatypeProperty ;
	rdfs:label "tags" ;
	rdfs:range seeker:Tag ;
	skos:definition "Free-form labels outside the creative-field vocabulary." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
