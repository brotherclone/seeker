@prefix seeker: <https://github.com/brotherclone/seeker/schema/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix pav: <http://purl.org/pav/> .
<https://github.com/brotherclone/seeker/schema.owl.ttl> dcterms:license "MIT" ;
	dcterms:title "Seeker ontology" ;
	pav:version "0.1.0" ;
	a owl:Ontology ;
	rdfs:label "seeker" ;
	rdfs:seeAlso <https://github.com/brotherclone/seeker/blob/develop/docs/concept.md> ;
	skos:definition "The ontology of record for Seeker, an idea engine for creative technology. Ideas are generated by colliding topic cards drawn from independent decks (a morphological box), checked against prior art, and argued over by adversarial agents. This schema defines the deck layer: cards, the decks that hold one axis of cards, the deck set a run draws from, and the creative fields cards belong to. Later changes extend it with ideas, roles, debates and runs." .
seeker:AxisId a rdfs:Datatype ;
	owl:equivalentClass _:c14n204 .
seeker:AxisVerdict a owl:Class ;
	rdfs:label "AxisVerdict" ;
	rdfs:subClassOf _:c14n109 , _:c14n157 , _:c14n197 , _:c14n202 , _:c14n268 , _:c14n369 , _:c14n391 , _:c14n412 , _:c14n450 ;
	skos:definition "The judge's verdict on one score axis of one comparison." ;
	skos:exactMatch seeker:AxisVerdict ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:CaptureSource\#gabe a owl:Class ;
	rdfs:label "gabe" ;
	rdfs:subClassOf seeker:CaptureSource ;
	skos:definition "Captured by hand, usually with the Web Clipper template." .
seeker:CaptureSource\#import a owl:Class ;
	rdfs:label "import" ;
	rdfs:subClassOf seeker:CaptureSource ;
	skos:definition "Imported in bulk from another catalog." .
seeker:CaptureSource\#prosecutor a owl:Class ;
	rdfs:label "prosecutor" ;
	rdfs:subClassOf seeker:CaptureSource ;
	skos:definition "Found by the prior-art prosecutor during a debate and cached." .
seeker:CaptureSource a owl:Class ;
	rdfs:label "CaptureSource" ;
	owl:unionOf _:c14n28 ;
	skos:definition "Who or what added a work to the vault, so hand-captured works can be told apart from ones agents found or imported in bulk." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> ;
	linkml:permissible_values seeker:CaptureSource\#gabe , seeker:CaptureSource\#import , seeker:CaptureSource\#prosecutor .
seeker:Card a owl:Class ;
	rdfs:label "Card" ;
	rdfs:seeAlso <https://en.wikipedia.org/wiki/Morphological_analysis_(problem-solving)> ;
	rdfs:subClassOf _:c14n119 , _:c14n203 , _:c14n291 , _:c14n297 , _:c14n335 , _:c14n349 , _:c14n438 , _:c14n449 , _:c14n45 , _:c14n451 , _:c14n457 , _:c14n458 , _:c14n57 , _:c14n8 , _:c14n96 ;
	skos:definition "One topic card, the atom of a draw. A draw takes one card from each of several decks and asks whether the collision is a real idea." ;
	skos:exactMatch seeker:Card ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:CardId a rdfs:Datatype ;
	owl:equivalentClass _:c14n271 .
seeker:CardReading a owl:Class ;
	rdfs:label "CardReading" ;
	rdfs:subClassOf _:c14n206 , _:c14n253 , _:c14n378 , _:c14n446 , _:c14n465 , _:c14n477 ;
	skos:definition "How the generator interpreted one drawn card. Under a metaphorical reading this is the only record of what a card was taken to mean." ;
	skos:exactMatch seeker:CardReading ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:Citation a owl:Class ;
	rdfs:label "Citation" ;
	rdfs:subClassOf _:c14n10 , _:c14n121 , _:c14n2 , _:c14n242 , _:c14n285 , _:c14n294 , _:c14n315 , _:c14n332 , _:c14n382 , _:c14n388 , _:c14n400 , _:c14n41 , _:c14n73 , _:c14n76 ;
	skos:definition "One piece of prior-art evidence: a web page the prosecutor's searches returned, or a work already in the vault's catalog." ;
	skos:exactMatch seeker:Citation ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:Comparison a owl:Class ;
	rdfs:label "Comparison" ;
	rdfs:subClassOf _:c14n110 , _:c14n127 , _:c14n139 , _:c14n140 , _:c14n141 , _:c14n161 , _:c14n163 , _:c14n180 , _:c14n23 , _:c14n246 , _:c14n247 , _:c14n264 , _:c14n288 , _:c14n390 , _:c14n394 , _:c14n431 , _:c14n459 , _:c14n460 ;
	skos:definition "One blind pairwise judgment between two debated ideas, with a winner on each score axis." ;
	skos:exactMatch seeker:Comparison ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:CreativeField\#comics a owl:Class ;
	rdfs:label "comics" ;
	rdfs:subClassOf seeker:CreativeField ;
	skos:definition "Comics, sequential art, strips, webcomics and minicomics." .
seeker:CreativeField\#electronics a owl:Class ;
	rdfs:label "electronics" ;
	rdfs:subClassOf seeker:CreativeField ;
	skos:definition "Sensors, circuits, microcontrollers, displays and physical computing." .
seeker:CreativeField\#film a owl:Class ;
	rdfs:label "film" ;
	rdfs:subClassOf seeker:CreativeField ;
	skos:definition "Film, video, animation and moving-image work of any length or format." .
seeker:CreativeField\#games a owl:Class ;
	rdfs:label "games" ;
	rdfs:subClassOf seeker:CreativeField ;
	skos:definition "Board, card, tabletop role-playing and electronic games." .
seeker:CreativeField\#music a owl:Class ;
	rdfs:label "music" ;
	rdfs:subClassOf seeker:CreativeField ;
	skos:definition "Composition, performance, sound design, synthesis and audio production." .
seeker:CreativeField\#visual-art a owl:Class ;
	rdfs:label "visual-art" ;
	rdfs:subClassOf seeker:CreativeField ;
	skos:definition "Drawing, painting, printmaking, generative and computational visual art, installation." .
seeker:CreativeField\#writing a owl:Class ;
	rdfs:label "writing" ;
	rdfs:subClassOf seeker:CreativeField ;
	skos:definition "Creative writing, poetry, interactive and procedural text, audio drama." .
seeker:CreativeField a owl:Class ;
	rdfs:label "CreativeField" ;
	owl:unionOf _:c14n475 ;
	skos:definition "The creative fields Seeker draws ideas from. A card belongs to every field it lists; a card listing none is cross-cutting and applies to all fields. Cards spanning several fields are the bridges between literatures that literature-based discovery looks for." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> ;
	linkml:permissible_values seeker:CreativeField\#comics , seeker:CreativeField\#electronics , seeker:CreativeField\#film , seeker:CreativeField\#games , seeker:CreativeField\#music , seeker:CreativeField\#visual-art , seeker:CreativeField\#writing .
seeker:Critique a owl:Class ;
	rdfs:label "Critique" ;
	rdfs:subClassOf _:c14n103 , _:c14n106 , _:c14n125 , _:c14n150 , _:c14n166 , _:c14n179 , _:c14n182 , _:c14n212 , _:c14n213 , _:c14n237 , _:c14n24 , _:c14n257 , _:c14n258 , _:c14n266 , _:c14n274 , _:c14n280 , _:c14n304 , _:c14n312 , _:c14n321 , _:c14n338 , _:c14n360 , _:c14n482 , _:c14n61 , _:c14n67 , _:c14n69 , _:c14n72 , _:c14n78 , _:c14n85 , _:c14n87 ;
	skos:definition "One critic's attack on one idea, naming the part that fails, how badly, and the failure in one sentence." ;
	skos:exactMatch seeker:Critique ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:CritiqueTarget\#behavior a owl:Class ;
	rdfs:label "behavior" ;
	rdfs:subClassOf seeker:CritiqueTarget ;
	skos:definition "What the thing does (the Y) fails or cannot be done." .
seeker:CritiqueTarget\#card_reading a owl:Class ;
	rdfs:label "card_reading" ;
	rdfs:subClassOf seeker:CritiqueTarget ;
	skos:definition "One card was read in a way the idea does not earn." .
seeker:CritiqueTarget\#constraint a owl:Class ;
	rdfs:label "constraint" ;
	rdfs:subClassOf seeker:CritiqueTarget ;
	skos:definition "The idea does not satisfy its constraint card." .
seeker:CritiqueTarget\#rationale a owl:Class ;
	rdfs:label "rationale" ;
	rdfs:subClassOf seeker:CritiqueTarget ;
	skos:definition "The reason (the Z) is false, circular or does not matter." .
seeker:CritiqueTarget\#subject a owl:Class ;
	rdfs:label "subject" ;
	rdfs:subClassOf seeker:CritiqueTarget ;
	skos:definition "The thing being made (the X) is wrong, vague or not new." .
seeker:CritiqueTarget a owl:Class ;
	rdfs:label "CritiqueTarget" ;
	owl:unionOf _:c14n411 ;
	skos:definition "Which part of an idea a critique says fails. Naming the part keeps a critique from being a general complaint." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> ;
	linkml:permissible_values seeker:CritiqueTarget\#behavior , seeker:CritiqueTarget\#card_reading , seeker:CritiqueTarget\#constraint , seeker:CritiqueTarget\#rationale , seeker:CritiqueTarget\#subject .
seeker:Debate a owl:Class ;
	rdfs:label "Debate" ;
	rdfs:subClassOf _:c14n167 , _:c14n170 , _:c14n174 , _:c14n195 , _:c14n222 , _:c14n337 , _:c14n342 , _:c14n372 , _:c14n38 , _:c14n399 , _:c14n53 , _:c14n77 ;
	skos:definition "One idea's round of debate: the critiques it faced, the advocate's defense, and the statement that goes on to compete." ;
	skos:exactMatch seeker:Debate ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:DebateFailure a owl:Class ;
	rdfs:label "DebateFailure" ;
	rdfs:subClassOf _:c14n152 , _:c14n158 , _:c14n177 , _:c14n186 , _:c14n221 , _:c14n284 , _:c14n316 , _:c14n352 , _:c14n361 , _:c14n405 , _:c14n423 , _:c14n464 , _:c14n471 , _:c14n51 , _:c14n97 ;
	skos:definition "A debate role that produced no valid answer for one idea, even after a retry." ;
	skos:exactMatch seeker:DebateFailure ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:DebateRun a owl:Class ;
	rdfs:label "DebateRun" ;
	rdfs:subClassOf _:c14n136 , _:c14n16 , _:c14n175 , _:c14n18 , _:c14n188 , _:c14n189 , _:c14n201 , _:c14n219 , _:c14n225 , _:c14n230 , _:c14n244 , _:c14n25 , _:c14n255 , _:c14n27 , _:c14n277 , _:c14n281 , _:c14n282 , _:c14n283 , _:c14n299 , _:c14n305 , _:c14n325 , _:c14n333 , _:c14n34 , _:c14n348 , _:c14n362 , _:c14n37 , _:c14n376 , _:c14n389 , _:c14n395 , _:c14n404 , _:c14n406 , _:c14n419 , _:c14n462 , _:c14n466 , _:c14n487 , _:c14n489 , _:c14n64 , _:c14n84 , _:c14n89 , _:c14n99 ;
	skos:definition "One debate over a recorded generation: its pinned inputs, every debate and failure, the tournament, and its usage and estimated cost." ;
	skos:exactMatch seeker:DebateRun ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:Deck a owl:Class ;
	rdfs:label "Deck" ;
	rdfs:subClassOf _:c14n0 , _:c14n200 , _:c14n273 , _:c14n279 , _:c14n290 , _:c14n300 , _:c14n308 , _:c14n328 , _:c14n417 , _:c14n422 , _:c14n426 ;
	skos:definition "All the cards on one axis of the morphological box, loaded from one file in decks/. Axes are independent, so cards from different decks combine freely." ;
	skos:exactMatch seeker:Deck ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:DeckSet a owl:Class ;
	rdfs:label "DeckSet" ;
	rdfs:subClassOf _:c14n196 , _:c14n59 ;
	skos:definition "Every deck a run draws from. Card ids are unique across the whole set and the set must include the required starting axes: technique, medium, historical-artifact, constraint and domain." ;
	skos:exactMatch seeker:DeckSet ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:Defense a owl:Class ;
	rdfs:label "Defense" ;
	rdfs:subClassOf _:c14n211 , _:c14n265 , _:c14n292 , _:c14n296 , _:c14n320 , _:c14n339 , _:c14n368 , _:c14n410 , _:c14n414 , _:c14n452 , _:c14n468 , _:c14n488 , _:c14n52 , _:c14n91 , _:c14n93 ;
	skos:definition "The advocate's answer to every critique of one idea, and what became of the idea." ;
	skos:exactMatch seeker:Defense ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:DefenseMove\#concede a owl:Class ;
	rdfs:label "concede" ;
	rdfs:subClassOf seeker:DefenseMove ;
	skos:definition "The critique is right." .
seeker:DefenseMove\#rebut a owl:Class ;
	rdfs:label "rebut" ;
	rdfs:subClassOf seeker:DefenseMove ;
	skos:definition "The critique is wrong or does not matter, with an argument why." .
seeker:DefenseMove a owl:Class ;
	rdfs:label "DefenseMove" ;
	owl:unionOf _:c14n122 ;
	skos:definition "How the advocate answers one critique." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> ;
	linkml:permissible_values seeker:DefenseMove\#concede , seeker:DefenseMove\#rebut .
seeker:DefenseOutcome\#defended a owl:Class ;
	rdfs:label "defended" ;
	rdfs:subClassOf seeker:DefenseOutcome ;
	skos:definition "The idea stands as stated." .
seeker:DefenseOutcome\#revised a owl:Class ;
	rdfs:label "revised" ;
	rdfs:subClassOf seeker:DefenseOutcome ;
	skos:definition "The idea is restated to survive the critiques." .
seeker:DefenseOutcome\#withdrawn a owl:Class ;
	rdfs:label "withdrawn" ;
	rdfs:subClassOf seeker:DefenseOutcome ;
	skos:definition "The advocate gives the idea up; it does not compete." .
seeker:DefenseOutcome a owl:Class ;
	rdfs:label "DefenseOutcome" ;
	owl:unionOf _:c14n485 ;
	skos:definition "What the advocate does with the idea after answering every critique." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> ;
	linkml:permissible_values seeker:DefenseOutcome\#defended , seeker:DefenseOutcome\#revised , seeker:DefenseOutcome\#withdrawn .
seeker:Draw a owl:Class ;
	rdfs:label "Draw" ;
	rdfs:subClassOf _:c14n145 , _:c14n156 , _:c14n194 , _:c14n236 , _:c14n298 , _:c14n364 , _:c14n387 , _:c14n408 , _:c14n429 , _:c14n439 , _:c14n456 , _:c14n479 ;
	skos:definition "One collision: three cards, one from each of three axes, always including a constraint. The raw material the generator turns into a one-sentence idea." ;
	skos:exactMatch seeker:Draw ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:DrawBatch a owl:Class ;
	rdfs:label "DrawBatch" ;
	rdfs:subClassOf _:c14n100 , _:c14n15 , _:c14n164 , _:c14n168 , _:c14n307 , _:c14n341 , _:c14n472 , _:c14n63 ;
	skos:definition "A balanced set of draws produced from one seed and one deck set: shapes evenly represented, no card repeated, home fields rotating through the creative fields. Fully reproducible from its seed and deck-set digest." ;
	skos:exactMatch seeker:DrawBatch ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:Effort\#high a owl:Class ;
	rdfs:label "high" ;
	rdfs:subClassOf seeker:Effort ;
	skos:definition "Thorough; the default for creative roles." .
seeker:Effort\#low a owl:Class ;
	rdfs:label "low" ;
	rdfs:subClassOf seeker:Effort ;
	skos:definition "Quickest and cheapest; minimal deliberation." .
seeker:Effort\#max a owl:Class ;
	rdfs:label "max" ;
	rdfs:subClassOf seeker:Effort ;
	skos:definition "The most thorough the model offers; slowest and costliest." .
seeker:Effort\#medium a owl:Class ;
	rdfs:label "medium" ;
	rdfs:subClassOf seeker:Effort ;
	skos:definition "Balanced speed and thoroughness." .
seeker:Effort\#xhigh a owl:Class ;
	rdfs:label "xhigh" ;
	rdfs:subClassOf seeker:Effort ;
	skos:definition "More thorough than high, at higher cost." .
seeker:Effort a owl:Class ;
	rdfs:label "Effort" ;
	owl:unionOf _:c14n427 ;
	skos:definition "How much effort a model puts into a response, as the Claude API's output_config.effort. Higher effort is more thorough, slower and costlier." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> ;
	linkml:permissible_values seeker:Effort\#high , seeker:Effort\#low , seeker:Effort\#max , seeker:Effort\#medium , seeker:Effort\#xhigh .
seeker:Generation a owl:Class ;
	rdfs:label "Generation" ;
	rdfs:subClassOf _:c14n11 , _:c14n13 , _:c14n131 , _:c14n132 , _:c14n137 , _:c14n14 , _:c14n147 , _:c14n153 , _:c14n154 , _:c14n165 , _:c14n178 , _:c14n22 , _:c14n224 , _:c14n245 , _:c14n250 , _:c14n251 , _:c14n254 , _:c14n293 , _:c14n302 , _:c14n340 , _:c14n354 , _:c14n370 , _:c14n375 , _:c14n39 , _:c14n393 , _:c14n398 , _:c14n402 , _:c14n413 , _:c14n443 , _:c14n444 , _:c14n467 ;
	skos:definition "One generator pass over a draw batch: the ideas and failures it produced, every input pinned (batch, reading, model, role digest, commit), and its token usage and estimated cost." ;
	skos:exactMatch seeker:Generation ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:GenerationFailure a owl:Class ;
	rdfs:label "GenerationFailure" ;
	rdfs:subClassOf _:c14n159 , _:c14n184 , _:c14n318 , _:c14n35 , _:c14n403 , _:c14n434 , _:c14n469 , _:c14n491 , _:c14n92 ;
	skos:definition "A draw for which no valid idea was produced, even after a retry." ;
	skos:exactMatch seeker:GenerationFailure ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:GitCommit a rdfs:Datatype ;
	owl:equivalentClass _:c14n309 .
seeker:Idea a owl:Class ;
	rdfs:label "Idea" ;
	rdfs:subClassOf _:c14n17 , _:c14n187 , _:c14n190 , _:c14n210 , _:c14n217 , _:c14n267 , _:c14n311 , _:c14n317 , _:c14n319 , _:c14n355 , _:c14n383 , _:c14n396 , _:c14n415 , _:c14n428 , _:c14n445 , _:c14n448 , _:c14n49 , _:c14n58 , _:c14n71 , _:c14n74 , _:c14n9 ;
	skos:definition "One idea generated from one draw: a single sentence of the form \"a/an X that does Y because Z\", its three parts, and how each card was read." ;
	skos:exactMatch seeker:Idea ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:IdeaRevision a owl:Class ;
	rdfs:label "IdeaRevision" ;
	rdfs:subClassOf _:c14n118 , _:c14n12 , _:c14n155 , _:c14n207 , _:c14n278 , _:c14n29 , _:c14n310 , _:c14n365 , _:c14n420 , _:c14n436 , _:c14n60 , _:c14n7 ;
	skos:definition "An idea restated by the advocate to survive its critiques, in the same one-sentence form and from the same draw." ;
	skos:exactMatch seeker:IdeaRevision ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:ModelId a rdfs:Datatype ;
	owl:equivalentClass _:c14n134 .
seeker:Rating a owl:Class ;
	rdfs:label "Rating" ;
	rdfs:subClassOf _:c14n116 , _:c14n128 , _:c14n149 , _:c14n192 , _:c14n20 , _:c14n227 , _:c14n238 , _:c14n252 , _:c14n26 , _:c14n272 , _:c14n289 , _:c14n353 , _:c14n356 , _:c14n4 , _:c14n473 ;
	skos:definition "One idea's Elo rating on one score axis." ;
	skos:exactMatch seeker:Rating ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:Reading\#literal a owl:Class ;
	rdfs:label "literal" ;
	rdfs:subClassOf seeker:Reading ;
	skos:definition "Cards mean exactly what they name." .
seeker:Reading\#loose a owl:Class ;
	rdfs:label "loose" ;
	rdfs:subClassOf seeker:Reading ;
	skos:definition "Cards may be taken by their spirit as well as their letter." .
seeker:Reading\#metaphorical a owl:Class ;
	rdfs:label "metaphorical" ;
	rdfs:subClassOf seeker:Reading ;
	skos:definition "Cards may stand for something they evoke rather than what they name." .
seeker:Reading a owl:Class ;
	rdfs:label "Reading" ;
	owl:unionOf _:c14n146 ;
	skos:definition "How freely the generator may interpret the cards it is dealt. Round 1 reads literally; round 2 varies only this setting." ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> ;
	linkml:permissible_values seeker:Reading\#literal , seeker:Reading\#loose , seeker:Reading\#metaphorical .
seeker:ReadingGuidance a owl:Class ;
	rdfs:label "ReadingGuidance" ;
	rdfs:subClassOf _:c14n138 , _:c14n261 , _:c14n275 , _:c14n295 , _:c14n31 , _:c14n486 ;
	skos:definition "The prompt text a role uses for one Reading setting." ;
	skos:exactMatch seeker:ReadingGuidance ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:Reply a owl:Class ;
	rdfs:label "Reply" ;
	rdfs:subClassOf _:c14n123 , _:c14n172 , _:c14n21 , _:c14n231 , _:c14n248 , _:c14n324 , _:c14n397 , _:c14n83 , _:c14n95 ;
	skos:definition "The advocate's answer to one critique." ;
	skos:exactMatch seeker:Reply ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:Role a owl:Class ;
	rdfs:label "Role" ;
	rdfs:subClassOf _:c14n101 , _:c14n191 , _:c14n193 , _:c14n234 , _:c14n256 , _:c14n276 , _:c14n287 , _:c14n306 , _:c14n313 , _:c14n323 , _:c14n326 , _:c14n336 , _:c14n379 , _:c14n386 , _:c14n409 , _:c14n424 , _:c14n474 , _:c14n481 , _:c14n54 , _:c14n62 , _:c14n68 , _:c14n79 , _:c14n86 , _:c14n98 ;
	skos:definition "One agent role in the pipeline, defined by a versioned YAML file in prompts/: its model, persona, standing instructions and per-reading guidance." ;
	skos:exactMatch seeker:Role ;
	skos:inScheme <https://github.com/brotherclone/seeker/schema> .
seeker:RoleDigest a owl:Class ;
	rdfs:label "RoleDigest" ;
	rdfs:subClassOf _:c14n233 , _:c14n286 , _:c14n350 , _:c14n42 , _:c14n435 , _:c14n454 ;
	skos:definition "The digest of one role file a run used." ;
